# Copia estas variables a tu archivo .env (el que genera "composer create-project"),
# reemplazando los valores de conexion a base de datos por los tuyos.

APP_NAME=Kairos
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kairos_db
DB_USERNAME=postgres
DB_PASSWORD=coloca_aqui_tu_password_de_postgres

FRONTEND_URL=http://localhost:5173
SESSION_DRIVER=cookie

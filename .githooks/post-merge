#!/bin/sh
# Despues de "git pull": si cambio la base de datos, la restaura sola.
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q "^database/kairos_db.dump$"; then
  echo "Base de datos nueva en el repositorio. Restaurando..."
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "scripts/restaurar-bd.ps1"
fi
